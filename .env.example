# DEX Trading Bot - Environment Configuration Template (Solana Edition)
# Copy this file to .env and fill in your actual values

# ============================================================================
# SIMULATION MODE (FOR TESTING)
# ============================================================================
# Set to "true" to test bot logic without real trades (recommended for sandbox)
# Set to "false" for production trading on a real server with internet access
# 
# In simulation mode:
# - No real blockchain transactions are executed
# - Mock balances are tracked internally
# - Simulated prices fluctuate slightly
# - Perfect for testing bot logic without spending money
SIMULATION_MODE=false

# ============================================================================
# SOLANA BLOCKCHAIN & DEX CONFIGURATION (REQUIRED)
# ============================================================================

# Solana RPC endpoint URL
# Examples:
#   - Mainnet Beta: https://api.mainnet-beta.solana.com
#   - Devnet: https://api.devnet.solana.com
#   - QuickNode: https://your-endpoint.solana-mainnet.quiknode.pro/YOUR_TOKEN/
#   - Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Private key for your Solana trading wallet (base58 encoded)
# ⚠️ SECURITY: Never commit this file with real private key to git!
# ⚠️ Use a dedicated wallet with limited funds for trading
# You can export this from Phantom, Solflare, or generate with solana-keygen
WALLET_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY_HERE

# Raydium Program ID (Liquidity Pool V4)
# Default: 675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8
RAYDIUM_PROGRAM_ID=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8

# Base token address (SOL - Wrapped SOL mint address)
# Default for SOL: So11111111111111111111111111111111111111112
BASE_TOKEN_ADDRESS=So11111111111111111111111111111111111111112

# Quote token address (MEMESAI or your SPL token mint address)
# MEMESAI on Solana: 8D9foi1nqfabp8D3uNJCrzt1xkvxq8xHYH8Lxb4fbonk
QUOTE_TOKEN_ADDRESS=8D9foi1nqfabp8D3uNJCrzt1xkvxq8xHYH8Lxb4fbonk

# Raydium pool ID for your trading pair (SOL/MEMESAI)
# Optional when using Jupiter Aggregator for swaps
# You can find this on Raydium UI or by querying Raydium pools
# Example: https://raydium.io/liquidity/pools/
# Leave as placeholder if using Jupiter API (bot will work without it)
RAYDIUM_POOL_ID=PLACEHOLDER_OPTIONAL_WITH_JUPITER


# ============================================================================
# TELEGRAM CONFIGURATION (REQUIRED)
# ============================================================================

# Telegram bot token from @BotFather
# Example: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz-1234567890
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of authorized Telegram user IDs
# To find your user ID, message @userinfobot on Telegram
# Example: 123456789,987654321,555555555
ALLOWED_TELEGRAM_IDS=123456789

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Path to SQLite database file (default: bot_data.db)
DATABASE_PATH=bot_data.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Maximum number of trades per session before auto-stop (default: 1000)
MAX_TRADES_PER_SESSION=1000

# Solana transaction configuration
# Maximum retries for sending transactions (default: 3)
MAX_RETRIES=3

# Skip preflight checks (default: false, set to true for faster but riskier txs)
SKIP_PREFLIGHT=false

# Transaction commitment level: finalized, confirmed, processed (default: confirmed)
COMMITMENT_LEVEL=confirmed

# Default slippage tolerance in basis points (default: 100 = 1%)
DEFAULT_SLIPPAGE_BPS=100

# RPC timeout in seconds (default: 30)
RPC_TIMEOUT=30

# Maximum RPC retry attempts (default: 3)
RPC_MAX_RETRIES=3

# ============================================================================
# NOTES
# ============================================================================

# 1. SECURITY: 
#    - Never commit the .env file to version control
#    - Keep your private key secure
#    - Use a dedicated wallet with limited funds
#    - Regularly rotate keys and monitor for unauthorized access

# 2. TESTING:
#    - Test on Solana devnet first
#    - Use small amounts initially on mainnet
#    - Verify all addresses are correct for Solana mainnet

# 3. GETTING YOUR PRIVATE KEY:
#    - From Phantom: Settings -> Show Private Key (export as base58)
#    - From Solflare: Settings -> Export Private Key
#    - From CLI: solana-keygen new (or recover existing)
#    - The key should be a base58 encoded string (not JSON array)

# 4. FINDING RAYDIUM POOL ID:
#    - Visit https://raydium.io/liquidity/pools/
#    - Search for your token pair (e.g., SOL/MEMESAI)
#    - Copy the pool ID from the URL or pool information
#    - Alternatively, use Raydium SDK to query pools programmatically

# 5. COMPLIANCE:
#    - This bot is for legitimate DCA/execution only
#    - NOT for wash trading, volume manipulation, or spoofing
#    - You are responsible for regulatory compliance in your jurisdiction

# 6. FINDING YOUR TELEGRAM USER ID:
#    - Message @userinfobot on Telegram
#    - It will reply with your user ID
#    - Add your ID to ALLOWED_TELEGRAM_IDS (comma-separated if multiple users)

# 7. RPC ENDPOINTS:
#    - Free public RPCs may have rate limits
#    - Consider using premium RPC providers for production:
#      * QuickNode: https://www.quicknode.com/
#      * Helius: https://helius.xyz/
#      * Alchemy: https://www.alchemy.com/solana
